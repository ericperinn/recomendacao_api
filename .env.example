# Banco de dados
DATABASE_URL_DADOS=postgresql+asyncpg://maisacesso:maisacesso@localhost:5434/maisacesso
DATABASE_URL_EMBEDDINGS=postgresql+asyncpg://recomendacao:recomendacao@localhost:5433/recomendacao_embeddings
POSTGRES_USER=recomendacao
POSTGRES_PASSWORD=recomendacao
POSTGRES_DB_DADOS=recomendacao_dados
POSTGRES_DB_EMBEDDINGS=recomendacao_embeddings

# Broker de fila (indexação assíncrona)
BROKER_URL=amqp://recomendacao:recomendacao@localhost:5672/
INDEX_QUEUE_NAME=recomendacao.indexacao

# Modelo SBERT
# Para usar o fine-tuned do TCC:  MODEL_PATH=./modelos/sbert_tcc_recrutamento_pt
# Para usar o modelo base HF:     MODEL_PATH=paraphrase-multilingual-mpnet-base-v2
MODEL_PATH=paraphrase-multilingual-mpnet-base-v2

# Recomendação
# Peso do score por similaridade semântica
SCORE_WEIGHT_COSINE=0.9
# Peso do score por sobreposição de palavras-chave
SCORE_WEIGHT_OVERLAP=0.1
# Bônus exclusivo para perfis PCD quando houver aderência
PCD_BONUS_EXCLUSIVE=0.05
# Limite mínimo para considerar uma vaga recomendável
MIN_SCORE_THRESHOLD=0.02
TOP_K_DEFAULT=10

# Admin
ADMIN_TOKEN=troque_em_producao
